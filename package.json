{
  "name": "cuteloader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:animations": "node --no-warnings --import ./scripts/register.mjs scripts/check-animations.ts",
    "test:exports": "node --no-warnings --import ./scripts/register.mjs scripts/test-exports.ts",
    "og": "node --no-warnings --import ./scripts/register.mjs scripts/generate-og.ts",
    "test": "npm run check:animations && npm run test:exports"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
