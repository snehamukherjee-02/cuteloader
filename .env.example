# Copy to .env.local for local development, or set these in your host's dashboard.
# Everything is optional except NEXT_PUBLIC_SITE_URL in production.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap.xml,
# Open Graph tags and the attribution link in exported code.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# GitHub repository (shows GitHub links; enables showcase submissions via issues)
NEXT_PUBLIC_GITHUB_URL=
# owner/repo, e.g. yourname/cuteloader (repository must be public for submissions)
NEXT_PUBLIC_GITHUB_REPO=

# Social
NEXT_PUBLIC_TWITTER_HANDLE=

# Search engine verification (paste only the token, not the whole meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loads only after visitor consent.
NEXT_PUBLIC_GA_ID=

# Google AdSense (ca-pub-XXXXXXXXXXXXXXXX) + ad unit slot IDs. Loads only after consent.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_BLOG=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
# Set to 1 to see dashed outlines where ads will appear (design review only)
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=

# QA scripts only: path to Chrome/Edge if not auto-detected
CHROME_PATH=
